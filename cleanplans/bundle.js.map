"// Guo-Hall parallel thinning — one pass (phase 0 or 1) over a packed\r\n// 1-bit-per-pixel image.\r\n//\r\n// Reference: Z. Guo and R. W. Hall, \"Parallel thinning with two-subiteration\r\n// algorithms\", Commun. ACM, 32(3):359–373, 1989.\r\n//\r\n// Neighbor labeling (standard):\r\n//   P9 P2 P3\r\n//   P8 P1 P4\r\n//   P7 P6 P5\r\n//\r\n// Phase 0 deletes P1 if:\r\n//   2 ≤ N(P1) ≤ 6  ∧  C(P1)=1  ∧  P2·P4·P8=0  ∧  P2·P4·P6=0\r\n//\r\n// Phase 1 deletes P1 if:\r\n//   2 ≤ N(P1) ≤ 6  ∧  C(P1)=1  ∧  P2·P6·P8=0  ∧  P4·P6·P8=0\r\n//\r\n// Buffer layout matches palette_decompose.wgsl:\r\n//   All layers packed sequentially; layer i starts at word offset\r\n//   layerBase = i * rowStride * height.\r\n//\r\n// Workgroup: 32×1 threads → one u32 word per workgroup (32 pixels × 1 row).\r\n// Dispatch:  (rowStride, height, 1)\r\n\r\nstruct Dims {\r\n    width:     u32,   // image width in pixels\r\n    height:    u32,   // image height in pixels\r\n    rowStride: u32,   // u32 words per row = ceil(width / 32)\r\n    phase:     u32,   // 0 = sub-iteration 1, 1 = sub-iteration 2\r\n    layerBase: u32,   // word offset into buffer for the start of this layer\r\n    _pad0:     u32,\r\n    _pad1:     u32,\r\n    _pad2:     u32,\r\n}\r\n\r\n@group(0) @binding(0) var<uniform>             dims:    Dims;\r\n@group(0) @binding(1) var<storage, read>       input:   array<u32>;\r\n@group(0) @binding(2) var<storage, read_write> output:  array<u32>;\r\n@group(0) @binding(3) var<storage, read_write> changed: array<atomic<u32>>;\r\n\r\n// Shared deletion mask for 32 pixels in this workgroup's word.\r\nvar<workgroup> wg_delete: atomic<u32>;\r\n\r\n// ---------------------------------------------------------------------------\r\n// Bit helpers\r\n// ---------------------------------------------------------------------------\r\n\r\nfn get_bit(x: i32, y: i32) -> u32 {\r\n    if (x < 0 || y < 0 || u32(x) >= dims.width || u32(y) >= dims.height) {\r\n        return 0u;\r\n    }\r\n    let idx = dims.layerBase + u32(y) * dims.rowStride + (u32(x) >> 5u);\r\n    return (input[idx] >> (u32(x) & 31u)) & 1u;\r\n}\r\n\r\n// Count 0→1 transitions in the cyclic sequence P2,P3,P4,P5,P6,P7,P8,P9,(P2).\r\nfn crossing_number(\r\n    p2: u32, p3: u32, p4: u32, p5: u32,\r\n    p6: u32, p7: u32, p8: u32, p9: u32,\r\n) -> u32 {\r\n    var c = 0u;\r\n    c += u32(p2 == 0u && p3 == 1u);\r\n    c += u32(p3 == 0u && p4 == 1u);\r\n    c += u32(p4 == 0u && p5 == 1u);\r\n    c += u32(p5 == 0u && p6 == 1u);\r\n    c += u32(p6 == 0u && p7 == 1u);\r\n    c += u32(p7 == 0u && p8 == 1u);\r\n    c += u32(p8 == 0u && p9 == 1u);\r\n    c += u32(p9 == 0u && p2 == 1u);\r\n    return c;\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n// Main\r\n// ---------------------------------------------------------------------------\r\n\r\n@compute @workgroup_size(32, 1)\r\nfn main(\r\n    @builtin(local_invocation_id) lid:  vec3<u32>,\r\n    @builtin(workgroup_id)        wgid: vec3<u32>,\r\n) {\r\n    // Zero shared deletion mask (workgroup memory is spec-guaranteed zero at\r\n    // invocation start, but explicit init + barrier is clearer).\r\n    if (lid.x == 0u) { atomicStore(&wg_delete, 0u); }\r\n    workgroupBarrier();\r\n\r\n    let word_x = wgid.x;  // u32-column index (0 .. rowStride-1)\r\n    let word_y = wgid.y;  // row index         (0 .. height-1)\r\n    let thread = lid.x;   // bit index in word (0 .. 31)\r\n\r\n    let x = i32(word_x * 32u + thread);\r\n    let y = i32(word_y);\r\n\r\n    if (u32(x) < dims.width && u32(y) < dims.height) {\r\n        let center = get_bit(x, y);\r\n        if (center == 1u) {\r\n            // 8-connected neighbours (north = decreasing y)\r\n            let p2 = get_bit(x,     y - 1); // N\r\n            let p3 = get_bit(x + 1, y - 1); // NE\r\n            let p4 = get_bit(x + 1, y);     // E\r\n            let p5 = get_bit(x + 1, y + 1); // SE\r\n            let p6 = get_bit(x,     y + 1); // S\r\n            let p7 = get_bit(x - 1, y + 1); // SW\r\n            let p8 = get_bit(x - 1, y);     // W\r\n            let p9 = get_bit(x - 1, y - 1); // NW\r\n\r\n            let n = p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;\r\n            let c = crossing_number(p2, p3, p4, p5, p6, p7, p8, p9);\r\n\r\n            var should_delete = false;\r\n            if (n >= 2u && n <= 6u && c == 1u) {\r\n                if (dims.phase == 0u) {\r\n                    should_delete = (p2 * p4 * p8 == 0u) && (p2 * p4 * p6 == 0u);\r\n                } else {\r\n                    should_delete = (p2 * p6 * p8 == 0u) && (p4 * p6 * p8 == 0u);\r\n                }\r\n            }\r\n\r\n            if (should_delete) {\r\n                atomicOr(&wg_delete, 1u << thread);\r\n            }\r\n        }\r\n    }\r\n    workgroupBarrier();\r\n\r\n    // Thread 0 applies the deletion mask and signals whether anything changed.\r\n    if (lid.x == 0u) {\r\n        let word_idx = dims.layerBase + word_y * dims.rowStride + word_x;\r\n        let del_bits = atomicLoad(&wg_delete);\r\n        output[word_idx] = input[word_idx] & ~del_bits;\r\n        if (del_bits != 0u) {\r\n            atomicOr(&changed[0], 1u);\r\n        }\r\n    }\r\n}\r\n"