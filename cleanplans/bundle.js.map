"// Palette cleanup: speckle removal and fringe absorption.\r\n//\r\n// Operates on the 1-bpp bit-plane buffer produced by palette_decompose.\r\n//\r\n// For each coloured pixel, the shader inspects a 7×7 neighbourhood and\r\n// applies the following rules:\r\n//\r\n//   Inner window  = 5×5 (±2 pixels)\r\n//   Outer ring    = 7×7 minus 5×5 (distance 3 in x or y)\r\n//\r\n//   myCount   = same-layer votes in the inner 5×5 window (incl. self)\r\n//   hasOuter  = any same-layer pixel exists in the outer ring\r\n//   bestCount = highest vote of any *other* layer in the inner window\r\n//   bestLayer = which other layer achieved bestCount\r\n//\r\n// Isolation: a pixel is considered \"isolated\" when ANY of the following hold:\r\n//\r\n//   A. smallBlob — all same-layer pixels in the inner window fit within a 2×2\r\n//      bounding box AND no same-layer pixel exists in the outer ring.\r\n//      Catches compact stipple blobs (including 2-pixel diagonals) without\r\n//      relying on the bridge heuristic (which can be fooled when the bridge\r\n//      point lands on another pixel in the same blob).\r\n//\r\n//   B. !hasBridgedOuter AND myCount ≤ 6 AND !isSandwiched — classic\r\n//      isolation: small cluster with no confirmed line continuation.\r\n//      hasBridgedOuter requires the immediate sign-direction neighbour to\r\n//      also be same-layer, so a 1-px gap between a stipple and a dash breaks\r\n//      the bridge.  isSandwiched (active only when myCount ≥ 4) protects\r\n//      dash interiors that have no outer continuation.\r\n//\r\n// Decision rules (in priority order):\r\n//   isolated  AND bestCount ≥ 8         → reassign to dominant neighbour\r\n//   isolated  AND bestCount < 8         → erase  (stipple / isolated artefact)\r\n//   bestCount ≥ 8 AND 2·bestCount ≥ 3·myCount\r\n//                                       → reassign  (dominant-neighbour fringe;\r\n//                                          covers both thin 1-3 px fringes and\r\n//                                          wider edge bands like red along orange)\r\n//   otherwise                           → keep\r\n//\r\n// Background hole filling (symmetric to foreground speck removal):\r\n//   Detects 1-pixel holes (all 4 ortho neighbours are foreground) and 2-pixel\r\n//   holes (exactly 1 background ortho neighbour Q, whose own 3 non-P ortho\r\n//   neighbours are all foreground).  Both patterns have no 4-connected path to\r\n//   the exterior background and would create spurious skeleton loops under\r\n//   Guo-Hall thinning.  Out-of-bounds neighbours count as background so that\r\n//   border pixels are never filled.\r\n//\r\n// Buffer layout (same as palette_decompose output):\r\n//   [layer 0 : rowStride × height × u32]\r\n//   …\r\n//   rowStride = ceil(width / 32)\r\n//\r\n// Workgroup: 32 × 1 — one workgroup per 32-pixel-wide row segment.\r\n\r\nconst MAX_LAYERS: u32 = 32u;\r\n\r\nstruct Dims {\r\n    width:      u32,\r\n    height:     u32,\r\n    rowStride:  u32,\r\n    numLayers:  u32,\r\n    _pad0:      u32,\r\n    _pad1:      u32,\r\n    _pad2:      u32,\r\n    _pad3:      u32,\r\n}\r\n\r\n@group(0) @binding(0) var<uniform>             dims: Dims;\r\n@group(0) @binding(1) var<storage, read>       src:  array<u32>;\r\n@group(0) @binding(2) var<storage, read_write> dst:  array<u32>;\r\n\r\nvar<workgroup> wg_bits: array<atomic<u32>, MAX_LAYERS>;\r\n\r\n// ---------------------------------------------------------------------------\r\n\r\nfn getSrcLayer(px: u32, py: u32) -> u32 {\r\n    let wordCol = px >> 5u;\r\n    let bit     = px & 31u;\r\n    let rowWord = py * dims.rowStride + wordCol;\r\n    for (var l = 0u; l < dims.numLayers; l++) {\r\n        let word = src[l * dims.rowStride * dims.height + rowWord];\r\n        if ((word >> bit) & 1u) != 0u {\r\n            return l;\r\n        }\r\n    }\r\n    return 255u;\r\n}\r\n\r\n// ---------------------------------------------------------------------------\r\n\r\n@compute @workgroup_size(32, 1)\r\nfn main(\r\n    @builtin(local_invocation_id)    lid:  vec3<u32>,\r\n    @builtin(local_invocation_index) lii:  u32,\r\n    @builtin(workgroup_id)           wgid: vec3<u32>,\r\n) {\r\n    if (lii < MAX_LAYERS) {\r\n        atomicStore(&wg_bits[lii], 0u);\r\n    }\r\n    workgroupBarrier();\r\n\r\n    let px = wgid.x * 32u + lid.x;\r\n    let py = wgid.y;\r\n\r\n    if (px < dims.width && py < dims.height) {\r\n        let myLayer = getSrcLayer(px, py);\r\n\r\n        if (myLayer < dims.numLayers) {\r\n            // ── Vote in the 7×7 window ──────────────────────────────────────\r\n            var votes: array<u32, MAX_LAYERS>;\r\n            var hasBridgedOuter = false;\r\n            var hasOuter        = false;\r\n            // Bounding box of same-layer pixels in the inner window (for smallBlob).\r\n            var bboxMinX = i32(px);\r\n            var bboxMaxX = i32(px);\r\n            var bboxMinY = i32(py);\r\n            var bboxMaxY = i32(py);\r\n\r\n            for (var dy: i32 = -3; dy <= 3; dy++) {\r\n                for (var dx: i32 = -3; dx <= 3; dx++) {\r\n                    let nx = i32(px) + dx;\r\n                    let ny = i32(py) + dy;\r\n                    if (nx >= 0 && ny >= 0 &&\r\n                        u32(nx) < dims.width && u32(ny) < dims.height) {\r\n                        let l = getSrcLayer(u32(nx), u32(ny));\r\n                        if (l < dims.numLayers) {\r\n                            let inner = (dx >= -2 && dx <= 2 && dy >= -2 && dy <= 2);\r\n                            if (inner) {\r\n                                votes[l]++;\r\n                                if (l == myLayer) {\r\n                                    bboxMinX = min(bboxMinX, nx);\r\n                                    bboxMaxX = max(bboxMaxX, nx);\r\n                                    bboxMinY = min(bboxMinY, ny);\r\n                                    bboxMaxY = max(bboxMaxY, ny);\r\n                                }\r\n                            } else if (l == myLayer) {\r\n                                hasOuter = true;\r\n                                // Two-hop bridge: BOTH the immediate neighbour AND\r\n                                // its next-step neighbour in the outer-pixel direction\r\n                                // must be same-layer.  A single-hop bridge is fooled\r\n                                // by a multi-pixel blob: one blob pixel provides hop 1\r\n                                // while the outer dash provides the context, leaving a\r\n                                // 1-pixel gap at hop 2 that correctly breaks the bridge.\r\n                                let bx = clamp(dx, -1, 1);\r\n                                let by = clamp(dy, -1, 1);\r\n                                let nb1x = i32(px) + bx;\r\n                                let nb1y = i32(py) + by;\r\n                                let nb2x = i32(px) + 2 * bx;\r\n                                let nb2y = i32(py) + 2 * by;\r\n                                if (nb1x >= 0 && nb1y >= 0 &&\r\n                                    u32(nb1x) < dims.width && u32(nb1y) < dims.height &&\r\n                                    nb2x >= 0 && nb2y >= 0 &&\r\n                                    u32(nb2x) < dims.width && u32(nb2y) < dims.height) {\r\n                                    if (getSrcLayer(u32(nb1x), u32(nb1y)) == myLayer &&\r\n                                        getSrcLayer(u32(nb2x), u32(nb2y)) == myLayer) {\r\n                                        hasBridgedOuter = true;\r\n                                    }\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            let myCount = votes[myLayer];\r\n\r\n            // smallBlob: all same-layer pixels in the inner window fit in a 2×2\r\n            // bounding box AND no same-layer pixel exists in the outer ring.\r\n            // This catches compact stipples (including diagonal pairs) without\r\n            // needing the bridge heuristic.\r\n            let bboxW = bboxMaxX - bboxMinX;\r\n            let bboxH = bboxMaxY - bboxMinY;\r\n            let fitsIn2x2 = (bboxW <= 1) && (bboxH <= 1);\r\n            let smallBlob = (!hasOuter) && fitsIn2x2;\r\n\r\n            // blobSmall2D: cluster has extent in BOTH dimensions (2D, not a line)\r\n            // and fits within a 4×4 bbox, with no outer-ring same-layer pixel.\r\n            // Catches blobs (4×2, 3×3, etc.) whose edge pixels falsely self-bridge\r\n            // through the blob's own interior — the 2-hop path stays inside the\r\n            // blob, so hasBridgedOuter is spuriously true even though there is no\r\n            // real line continuation.  Pure 1D runs (bboxH=0 or bboxW=0) are\r\n            // excluded so that short dashes still use count+isSandwiched rules.\r\n            let blobSmall2D = (!hasOuter) && (bboxW >= 1) && (bboxH >= 1)\r\n                           && (bboxW <= 3) && (bboxH <= 3);\r\n\r\n            // isSandwiched: same-layer on both sides in any direction.\r\n            // Guard: myCount >= 4 prevents a 3-pixel run's centre from being\r\n            // protected (it would survive as a 1-pixel relic otherwise).\r\n            let ipx = i32(px);\r\n            let ipy = i32(py);\r\n            let iw  = i32(dims.width);\r\n            let ih  = i32(dims.height);\r\n            var isSandwiched = false;\r\n            if (myCount >= 4u) {\r\n                // Horizontal\r\n                if (!isSandwiched && ipx > 0 && ipx < iw - 1) {\r\n                    if (getSrcLayer(u32(ipx - 1), py) == myLayer &&\r\n                        getSrcLayer(u32(ipx + 1), py) == myLayer) {\r\n                        isSandwiched = true;\r\n                    }\r\n                }\r\n                // Vertical\r\n                if (!isSandwiched && ipy > 0 && ipy < ih - 1) {\r\n                    if (getSrcLayer(px, u32(ipy - 1)) == myLayer &&\r\n                        getSrcLayer(px, u32(ipy + 1)) == myLayer) {\r\n                        isSandwiched = true;\r\n                    }\r\n                }\r\n                // NW-SE diagonal\r\n                if (!isSandwiched && ipx > 0 && ipy > 0 && ipx < iw - 1 && ipy < ih - 1) {\r\n                    if (getSrcLayer(u32(ipx - 1), u32(ipy - 1)) == myLayer &&\r\n                        getSrcLayer(u32(ipx + 1), u32(ipy + 1)) == myLayer) {\r\n                        isSandwiched = true;\r\n                    }\r\n                }\r\n                // NE-SW diagonal\r\n                if (!isSandwiched && ipx > 0 && ipy > 0 && ipx < iw - 1 && ipy < ih - 1) {\r\n                    if (getSrcLayer(u32(ipx + 1), u32(ipy - 1)) == myLayer &&\r\n                        getSrcLayer(u32(ipx - 1), u32(ipy + 1)) == myLayer) {\r\n                        isSandwiched = true;\r\n                    }\r\n                }\r\n            }\r\n\r\n            // Best competing (other-layer) count in the inner window.\r\n            var bestLayer = 255u;\r\n            var bestCount = 0u;\r\n            for (var l = 0u; l < dims.numLayers; l++) {\r\n                if (l != myLayer && votes[l] > bestCount) {\r\n                    bestCount = votes[l];\r\n                    bestLayer = l;\r\n                }\r\n            }\r\n\r\n            // ── Apply rules ────────────────────────────────────────────────\r\n            // A pixel is isolated when it has no confirmed outer continuation and\r\n            // is not sandwiched between same-layer pixels.\r\n            // Note: the former myCount ≤ 6 guard is removed.  It was meant to\r\n            // protect medium-length features, but inflated myCount from a nearby\r\n            // dash (which lands inside the ±2 inner window) wrongly shielded\r\n            // stipple blobs.  isSandwiched guards all legitimate line interiors;\r\n            // hasBridgedOuter guards endpoints and edges with real continuation.\r\n            let isolated = smallBlob || blobSmall2D ||\r\n                           ((!hasBridgedOuter) && (!isSandwiched));\r\n\r\n            // Relative dominance: other layer is at least 1.5× as common.\r\n            let dominates = (bestCount >= 8u) && (bestCount * 2u >= myCount * 3u);\r\n\r\n            var outLayer = myLayer;\r\n            if (isolated) {\r\n                if (bestCount >= 8u) {\r\n                    outLayer = bestLayer;   // fringe blob abutting a bulk colour\r\n                } else {\r\n                    outLayer = 255u;        // erase: stipple / isolated artefact\r\n                }\r\n            } else if (dominates) {\r\n                outLayer = bestLayer;       // fringe dominated by a neighbour layer\r\n            }\r\n\r\n            if (outLayer < dims.numLayers) {\r\n                atomicOr(&wg_bits[outLayer], 1u << lid.x);\r\n            }\r\n        }\r\n        // Background hole filling.\r\n        //\r\n        // Under Guo-Hall thinning (8-connected foreground, 4-connected background)\r\n        // a background pixel with no 4-connected path to the exterior cannot reach\r\n        // the outside background — it is a topological hole that forces the skeleton\r\n        // to loop.  We detect:\r\n        //\r\n        //   1-pixel hole: all 4 orthogonal neighbours are foreground.\r\n        //   2-pixel hole: exactly 1 background ortho neighbour Q, and Q's own\r\n        //                 3 non-P ortho neighbours are all foreground.\r\n        //\r\n        // Out-of-bounds neighbours count as background → border pixels are safe.\r\n\r\n        let ipx2 = i32(px);\r\n        let ipy2 = i32(py);\r\n        let iw2  = i32(dims.width);\r\n        let ih2  = i32(dims.height);\r\n\r\n        var fv: array<u32, MAX_LAYERS>;   // foreground vote accumulator\r\n\r\n        // Fetch orthogonal neighbour layers (255 = background or OOB).\r\n        var lN = 255u;\r\n        if (ipy2 > 0)      { lN = getSrcLayer(px, u32(ipy2 - 1)); if (lN < dims.numLayers) { fv[lN]++; } }\r\n        var lS = 255u;\r\n        if (ipy2 < ih2-1)  { lS = getSrcLayer(px, u32(ipy2 + 1)); if (lS < dims.numLayers) { fv[lS]++; } }\r\n        var lW = 255u;\r\n        if (ipx2 > 0)      { lW = getSrcLayer(u32(ipx2 - 1), py); if (lW < dims.numLayers) { fv[lW]++; } }\r\n        var lE = 255u;\r\n        if (ipx2 < iw2-1)  { lE = getSrcLayer(u32(ipx2 + 1), py); if (lE < dims.numLayers) { fv[lE]++; } }\r\n\r\n        let bgN = u32(lN >= dims.numLayers);\r\n        let bgS = u32(lS >= dims.numLayers);\r\n        let bgW = u32(lW >= dims.numLayers);\r\n        let bgE = u32(lE >= dims.numLayers);\r\n        let nBg = bgN + bgS + bgW + bgE;\r\n\r\n        var shouldFill = false;\r\n\r\n        if (nBg == 0u) {\r\n            // 1-pixel hole: all four ortho neighbours are foreground.\r\n            shouldFill = true;\r\n        } else if (nBg == 1u) {\r\n            // Candidate 2-pixel hole.  Locate the partner pixel Q (the one\r\n            // background ortho neighbour) and verify that Q's own 3 non-P\r\n            // ortho neighbours are all foreground.\r\n            var qx = ipx2; var qy = ipy2;\r\n            // skipQ*: which of Q's four ortho directions points back to P.\r\n            var skipQN = false; var skipQS = false;\r\n            var skipQW = false; var skipQE = false;\r\n            if      (bgN != 0u) { qy = ipy2 - 1; skipQS = true; }\r\n            else if (bgS != 0u) { qy = ipy2 + 1; skipQN = true; }\r\n            else if (bgW != 0u) { qx = ipx2 - 1; skipQE = true; }\r\n            else                { qx = ipx2 + 1; skipQW = true; }\r\n\r\n            if (qx >= 0 && qy >= 0 && qx < iw2 && qy < ih2) {\r\n                var qOk = true;\r\n                // Q's North\r\n                if (qOk && !skipQN) {\r\n                    let qny = qy - 1;\r\n                    if (qny < 0) { qOk = false; }\r\n                    else { let ql = getSrcLayer(u32(qx), u32(qny)); if (ql >= dims.numLayers) { qOk = false; } else { fv[ql]++; } }\r\n                }\r\n                // Q's South\r\n                if (qOk && !skipQS) {\r\n                    let qsy = qy + 1;\r\n                    if (qsy >= ih2) { qOk = false; }\r\n                    else { let ql = getSrcLayer(u32(qx), u32(qsy)); if (ql >= dims.numLayers) { qOk = false; } else { fv[ql]++; } }\r\n                }\r\n                // Q's West\r\n                if (qOk && !skipQW) {\r\n                    let qwx = qx - 1;\r\n                    if (qwx < 0) { qOk = false; }\r\n                    else { let ql = getSrcLayer(u32(qwx), u32(qy)); if (ql >= dims.numLayers) { qOk = false; } else { fv[ql]++; } }\r\n                }\r\n                // Q's East\r\n                if (qOk && !skipQE) {\r\n                    let qex = qx + 1;\r\n                    if (qex >= iw2) { qOk = false; }\r\n                    else { let ql = getSrcLayer(u32(qex), u32(qy)); if (ql >= dims.numLayers) { qOk = false; } else { fv[ql]++; } }\r\n                }\r\n                if (qOk) { shouldFill = true; }\r\n            }\r\n        }\r\n\r\n        if (shouldFill) {\r\n            var bestFill = 0u;\r\n            for (var lo = 1u; lo < dims.numLayers; lo++) {\r\n                if (fv[lo] > fv[bestFill]) { bestFill = lo; }\r\n            }\r\n            atomicOr(&wg_bits[bestFill], 1u << lid.x);\r\n        }\r\n    }\r\n\r\n    workgroupBarrier();\r\n\r\n    if (lii < dims.numLayers) {\r\n        let wi        = py * dims.rowStride + wgid.x;\r\n        let layerBase = lii * dims.rowStride * dims.height;\r\n        dst[layerBase + wi] = atomicLoad(&wg_bits[lii]);\r\n    }\r\n}\r\n"